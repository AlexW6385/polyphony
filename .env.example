# Copy to .env and fill in at least one API key.

# Inside docker compose these are overridden to point at the compose services.
DATABASE_URL=postgresql+asyncpg://polyphony:polyphony@localhost:5432/polyphony
REDIS_URL=redis://localhost:6379/0

# Two tiers. Each picks a provider independently:
#   openai | anthropic | gemini | deepseek | ollama
# `openai` with a *_BASE_URL works for any OpenAI-compatible endpoint.

# listen: cheap, called on every stream movement by every voice
LISTEN_PROVIDER=openai
LISTEN_MODEL=gpt-4o-mini
LISTEN_BASE_URL=
LISTEN_API_KEY=

# speak: strong, only called when a voice decides to speak (and for cadences)
SPEAK_PROVIDER=anthropic
SPEAK_MODEL=claude-sonnet-4-5
SPEAK_BASE_URL=
SPEAK_API_KEY=

# senses need web search: openai (official API), anthropic, or gemini.
# Empty = use the speak tier.
SENSE_PROVIDER=
SENSE_MODEL=

# Provider-wide fallbacks, used when a tier's own key is empty or when a voice
# overrides its provider in front matter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

RECENT_WINDOW=40
STRAYS=4
# comma-separated subset of voices to run; empty = all enabled voices
ENABLED_VOICES=
PORT=8000
