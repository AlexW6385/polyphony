# Optional. With Docker Compose nothing here is required: open the settings page
# (http://localhost:8000/settings), pick a provider, paste its API key and name the listen
# and speak models. What is saved there overrides this file.

# Providers: anthropic | openai | deepseek | gemini (`openai` with a *_BASE_URL works for
# any OpenAI-compatible endpoint).

# listen: decides whether a voice speaks; runs on every new thought, once per voice.
LISTEN_PROVIDER=anthropic
LISTEN_MODEL=claude-haiku-5-5

# speak: what a voice says, cadence rounds and the digest.
SPEAK_PROVIDER=anthropic
SPEAK_MODEL=claude-sonnet-5-5

# One key per provider; a tier uses the key of its provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Outside Docker Compose, point these at your own PostgreSQL and Redis.
DATABASE_URL=postgresql+asyncpg://polyphony:polyphony@localhost:5432/polyphony
REDIS_URL=redis://localhost:6379/0
PORT=8000

# Senses run once a day at their daily time in this timezone.
TIMEZONE=America/Toronto

# Voices may search the web once when they speak (Anthropic only)
SPEAK_WEB_SEARCH=true

# Memory: older thoughts related to what is being said now (pgvector). Runs an embedding
# model locally through Ollama by default: `ollama pull qwen3-embedding:0.6b`. Empty
# EMBED_PROVIDER turns memory off. Compose points EMBED_BASE_URL at Ollama on the host.
# Changing EMBED_MODEL or EMBED_DIM re-embeds every thought in the background.
EMBED_PROVIDER=ollama
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
# EMBED_BASE_URL=http://localhost:11434
# With EMBED_PROVIDER=openai (any OpenAI-compatible /v1/embeddings): EMBED_API_KEY=...
MEMORY_K=4
MEMORY_MIN_SIMILARITY=0.5

# Decisions: llm (the listen model) or jev (TypeSafe's decision model) for listen, the cadence
# rounds and the clerk's "is a vote due". Also switchable on the settings page.
DECIDER=llm
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Voices start listening at random within this many seconds per enabled voice after a new
# thought (10 voices -> within 5 s).
LISTEN_STAGGER_PER_VOICE=0.5
