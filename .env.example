# Copy to .env. Minimum: Ollama running locally + one hosted key for the speak tier.

# Inside docker compose these are overridden to point at the compose services.
DATABASE_URL=postgresql+asyncpg://polyphony:polyphony@localhost:5432/polyphony
REDIS_URL=redis://localhost:6379/0
# Prefix of every Redis key. Evals and the simulator use their own automatically.
NAMESPACE=polyphony

# Which ensemble to run: mind | council | public (or your own under ensembles/)
ENSEMBLE=mind

# Tiers. Each picks a provider independently: openai | anthropic | gemini | deepseek | ollama
# `openai` with a *_BASE_URL works for any OpenAI-compatible endpoint.

# listen: hot path (every stream move, every voice) -> local small model by default.
# If Ollama is unreachable Polyphony fails loudly; it never falls back to a paid tier.
LISTEN_PROVIDER=ollama
LISTEN_MODEL=qwen2.5:3b          # qwen2.5:1.5b on 8 GB machines; polyphony-listen once distilled
LISTEN_BASE_URL=                 # default http://localhost:11434 (Docker on macOS: host.docker.internal)

# speak: strong, only when a voice speaks; also cadences and the digest
SPEAK_PROVIDER=anthropic
SPEAK_MODEL=claude-sonnet-4-5
SPEAK_BASE_URL=
SPEAK_API_KEY=

# senses: triage + summarise what was read from feeds. Empty = speak tier.
SENSE_PROVIDER=
SENSE_MODEL=

# teacher: labels a share of listens in the background (shadow teacher), judges evals,
# and plays both tiers in the simulator. Empty = speak tier.
TEACHER_PROVIDER=
TEACHER_MODEL=
TEACHER_SAMPLE_RATE=0.05

# memory: embeddings, local by default. Empty provider = memory off.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
MEMORY_K=5

# digest: quiet this long (no new thought, nobody forming) -> write a digest
DIGEST_IDLE_SECONDS=90

# senses over MCP
MCP_FETCH_COMMAND=uvx mcp-server-fetch
MCP_FEEDS_COMMAND=python -m polyphony.mcp_servers.feeds
EXA_API_KEY=                     # optional: web search for senses with search: true
TAVILY_API_KEY=
SENSE_MAX_ITEMS=3
SENSE_READ_MAX_ARTICLES=3

# Polyphony as an MCP server (python -m polyphony.mcp_servers.mind --http). No auth:
# keep it on 127.0.0.1 unless you mean to expose it.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001
API_URL=http://127.0.0.1:8000

# Provider-wide fallbacks, used when a tier's own key is empty or when a voice
# overrides its provider in front matter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_KEEP_ALIVE=30m

RECENT_WINDOW=40
STRAYS=4
ENABLED_VOICES=                  # comma-separated subset; empty = all enabled voices
PORT=8000
